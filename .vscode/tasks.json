{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "npm: start-client",
            "type": "shell",
            "command": "npm",
            "args": ["start"],
            "options": {
                "cwd": "${workspaceFolder}/client"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": [
                {
                    "owner": "custom",
                    "pattern": {
                        "regexp": "."
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "Starting the development server",
                        "endsPattern": "Compiled successfully"
                    }
                }
            ]
        }
    ]
}
